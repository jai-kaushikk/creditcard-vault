{
  "name": "cardvault-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CardVault API: stores transactions only; relays sealed card shares and OTPs from memory.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --experimental-strip-types src/index.ts",
    "dev": "STORE=memory node --experimental-strip-types --watch src/index.ts",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fastify": "5.12.5",
    "google-auth-library": "11.1.0",
    "jose": "6.2.12",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "typescript": "6.0.3"
  }
}
